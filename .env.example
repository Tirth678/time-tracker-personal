# Copy this file to .env.local and fill in what you need.
# Everything here is optional: without a database the app keeps your sessions
# in the browser (localStorage) and still works.

# PostgreSQL connection string. When set, sessions are stored in the database
# and synced across your devices. The table is created automatically.
# POSTGRES_URL is used as a fallback, so the Vercel Postgres/Neon integration
# works without extra configuration.
#
#   Local:   postgres://postgres:password@localhost:5432/study_tracker
#   Hosted:  postgres://user:password@host/dbname?sslmode=require
DATABASE_URL=

# Only for `next dev` opened through a tunnel, a cloud IDE or another device:
# extra hostnames allowed to load the dev assets (comma-separated, `*` matches
# one label). Not used in production.
# ALLOWED_DEV_ORIGINS=*.example.dev

# Only for `npm test`: also run the API tests against this real PostgreSQL
# server (they always run against an in-memory Postgres). The tests wipe the
# study_sessions table, so never point this at a database you care about.
# TEST_DATABASE_URL=postgres://postgres:password@localhost:5432/study_tracker_test
